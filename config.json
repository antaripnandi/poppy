{
  "appearance": {
    "theme": "Pure black",
    "style": "Notch",
    "collapsed_width": 240,
    "collapsed_height": 30,
    "open_width": 960,
    "open_height": 480,
    "corner_radius": 16,
    "top_offset": 0,
    "display": "Primary"
  },
  "tabs": {
    "enabled": [
      "Home",
      "Music",
      "Calendar",
      "Clipboard",
      "Docs",
      "Desktops",
      "Timer",
      "Shelf",
      "Notes"
    ]
  },
  "notifications": {
    "enabled": true,
    "show_island_on_notify": true,
    "mute_in_focus": true,
    "sound": true,
    "preview_text": true
  },
  "screentime": {
    "enabled": true,
    "show_in_main_menu": true,
    "track_apps": true,
    "idle_threshold_seconds": 120,
    "daily_goal_hours": 6,
    "goal_alert_enabled": true,
    "break_reminders_enabled": true,
    "break_interval_minutes": 60,
    "excluded_apps": [
      "keepass",
      "1password"
    ]
  },
  "media": {
    "spotify_sp_dc": "",
    "auto_scroll_lyrics": true
  },
  "weather": {
    "city": "chennai",
    "unit": "celsius"
  },
  "pomodoro": {
    "work_duration": 1500,
    "break_duration": 300,
    "long_break_duration": 900,
    "sound_enabled": true
  },
  "notch": {
    "auto_hover_peek": true,
    "scroll_volume": true,
    "default_tab": "Smart",
    "animation_duration_ms": 200,
    "keep_in_tray": true,
    "autostart": false
  },
  "discord_rpc": {
    "enabled": false,
    "client_id": "120000000000000000",
    "mode": "dynamic",
    "custom_presence": {
      "details": "Deep Work with Poppy",
      "state": "Focus Session",
      "large_image": "poppy_logo",
      "large_text": "Poppy Productivity Island",
      "small_image": "badge_pro",
      "small_text": "Focusing",
      "buttons": [
        {
          "label": "Get Poppy",
          "url": "https://github.com"
        }
      ]
    },
    "dynamic_templates": {
      "pomo_focus": {
        "details": "Focus Sprint #{cycle}",
        "state": "{task}",
        "large_image": "focus_icon",
        "large_text": "Focusing with Poppy",
        "small_image": "clock",
        "small_text": "{remaining} left"
      },
      "pomo_break": {
        "details": "Short Break",
        "state": "Recharging",
        "large_image": "coffee_icon",
        "large_text": "On Break",
        "small_image": "green_check",
        "small_text": "{remaining} left"
      },
      "media": {
        "details": "{title}",
        "state": "by {artist}",
        "large_image": "music_disc",
        "large_text": "{album}",
        "small_image": "play_icon",
        "small_text": "Playing"
      }
    }
  },
  "hardware_hud": {
    "monitor_gpu": true,
    "monitor_battery": true
  }
}